{
  "manifest_version": 2,
  "name": "Label chips for Gmail",
  "version": "1.7.1",
  "description": "Shows Gmail labels, in their Gmail colors, below the subject on message list cards, and flags Inbox messages whose conversation is already archived.",
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gmail-label-chips@interledger.org",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "menus",
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "https://gmail.googleapis.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "message_display_action": {
    "type": "menu",
    "default_label": "Label",
    "default_title": "Add a Gmail label",
    "default_icon": "icons/label-dark.svg",
    "theme_icons": [
      {
        "light": "icons/label-light.svg",
        "dark": "icons/label-dark.svg",
        "size": 16
      },
      {
        "light": "icons/label-light.svg",
        "dark": "icons/label-dark.svg",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "experiment_apis": {
    "gmailLabelChips": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "gmailLabelChips"
          ]
        ],
        "script": "api/implementation.js"
      }
    }
  }
}
